meta {
  name: Create API Key
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api-keys
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "project_id": "{{projectId}}",
    "name": "Production Key"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("apiKeyId", res.body.data.id);
    bru.setEnvVar("apiKey", res.body.data.key);
  }
}
