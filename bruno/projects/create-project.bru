meta {
  name: Create Project
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/projects
  body: json
  auth: bearer
}

auth:bearer {
  token: {{accessToken}}
}

body:json {
  {
    "name": "My App",
    "slug": "my-app",
    "description": "Production application",
    "environment": "production"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setVar("projectId", res.body.data.id);
  }
}
