meta {
  name: Ingest Log
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/logs
  body: json
  auth: none
}

headers {
  X-API-Key: {{apiKey}}
}

body:json {
  {
    "level": "info",
    "message": "User logged in successfully",
    "service": "auth-service",
    "fields": {
      "user_id": "abc123",
      "ip": "192.168.1.1"
    }
  }
}
